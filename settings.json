{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "outputStyle": "intermedio",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm install*)",
      "Bash(pnpm i)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm format*)",
      "Bash(pnpm run *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm why *)",
      "Bash(pnpm list*)",
      "Bash(pnpm outdated*)",
      "Bash(pnpm audit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash push*)",
      "Bash(git stash list*)",
      "Bash(git stash pop*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(gh pr create *)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh repo view*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose start*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose pull*)",
      "Bash(prisma generate*)",
      "Bash(prisma format*)",
      "Bash(prisma validate*)",
      "Bash(prisma migrate dev*)",
      "Bash(prisma migrate status*)",
      "Bash(prisma studio*)",
      "Bash(turbo *)",
      "Bash(tsc *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cd *)",
      "Bash(tree *)",
      "Bash(~/.claude/skills/mem-search/scripts/mem-search.sh *)",
      "Bash(~/.claude/skills/brechas/scripts/brechas.mjs)",
      "Bash(~/.claude/skills/brechas/scripts/brechas.mjs *)",
      "Bash(playwright *)",
      "Bash(jest *)",
      "WebFetch(domain:*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx playwright *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker images*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/kimi.key)",
      "Bash(pnpm config set *)",
      "Bash(pnpm config delete *)",
      "Bash(pnpm * --config.*)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete *)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "defaultMode": "auto",
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune*)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm add -g *)",
      "Bash(npm install -g *)",
      "Bash(npm exec *)",
      "Bash(rm -rf *)",
      "Bash(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)",
      "Bash(git branch -D *)",
      "Bash(pnpm publish*)",
      "Bash(docker compose down*)",
      "Bash(docker exec *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(prisma db push*)",
      "Bash(npx prisma db push*)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/guard.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/supply-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/format.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/notify.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "ai-lordkit": {
      "source": {
        "source": "github",
        "repo": "FrankLord27/ai-lordkit",
        "sparsePaths": [
          ".claude-plugin"
        ]
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "prisma@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "hostinger@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "react-best-practices@ai-lordkit": true,
    "composition-patterns@ai-lordkit": true,
    "web-design-guidelines@ai-lordkit": true,
    "emil-design-eng@ai-lordkit": true,
    "review-animations@ai-lordkit": true,
    "improve-animations@ai-lordkit": true,
    "animation-performance@ai-lordkit": true,
    "impeccable@ai-lordkit": true,
    "taste-skill@ai-lordkit": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/hooks/statusline.sh\""
  }
}
